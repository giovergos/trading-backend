ENVIRONMENT=development

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=trading
POSTGRES_PASSWORD=trading
POSTGRES_DB=trading

REDIS_HOST=redis
REDIS_PORT=6379

EXCHANGE_ID=binance
SYMBOLS=BTC/USDT,ETH/USDT
TIMEFRAME=1h
OHLCV_BACKFILL_LIMIT=500
WS_RECONNECT_DELAY=5

# --- On-chain / Ethereum ---
ETH_RPC_URL=
ETH_POLL_INTERVAL=12
STABLECOIN_THRESHOLD=1000000
ONCHAIN_MAX_BLOCK_SPAN=50

# --- Strategy ---
STRATEGY_WINDOW=20
STRATEGY_NUM_STD=2.0
STRATEGY_EXIT_Z=0.0

# --- Backtest ---
BACKTEST_INITIAL_CAPITAL=10000
BACKTEST_FEE_RATE=0.001

# --- Paper trading ---
PAPER_CAPITAL_PER_SYMBOL=10000
PAPER_FEE_RATE=0.001
PAPER_EXECUTION_INTERVAL=60
